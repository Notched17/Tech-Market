    },
    {
      "name": "Field",
      "kind": "input",
      "refersTo": "field",
      "description": "Square sheet-filled input with label and note hint; blue ring and tint halo on focus.",
      "html": "<label class=\"ds-field-wrap\"><span class=\"ds-field-label\">Job title</span><input class=\"ds-field\" placeholder=\"e.g. Move our office network onto a managed firewall\"><span class=\"ds-note\">Say what needs doing in a sentence.</span></label>",
      "css": ".ds-field-wrap{display:flex;flex-direction:column;gap:0.375rem;font-family:Chivo,ui-sans-serif,system-ui,sans-serif;color:var(--ink,#12213a)}.ds-field-label{font-weight:600}.ds-note{font-size:0.875rem;line-height:1.3;font-weight:500;color:var(--ink-2,#475872)}.ds-field{min-height:2.75rem;border:1px solid var(--rule-strong,#7f93b3);background:var(--sheet,#fbfcfe);border-radius:0;padding:0.625rem 0.75rem;font:1rem/1.4 Chivo,ui-sans-serif,system-ui,sans-serif;color:var(--ink,#12213a);caret-color:var(--blue,#1a4e9e);transition:border-color 150ms cubic-bezier(0.16,1,0.3,1),box-shadow 150ms cubic-bezier(0.16,1,0.3,1)}.ds-field::placeholder{color:var(--ink-2,#475872);opacity:0.8}.ds-field:hover{border-color:var(--ink-2,#475872)}.ds-field:focus,.ds-field:focus-visible{outline:none;border-color:var(--blue,#1a4e9e);box-shadow:0 0 0 1px var(--blue,#1a4e9e),0 0 0 4px var(--tint,#e3ecf7)}"
    },
    {
      "name": "Navigation",
      "kind": "nav",
      "refersTo": "nav",
      "description": "Sheet bar with the dimension-line wordmark; current page blue with a 2px underline bar.",
      "html": "<header class=\"ds-nav\"><span class=\"ds-wordmark\"><span>Docket</span><svg viewBox=\"0 0 80 8\" preserveAspectRatio=\"none\" aria-hidden=\"true\"><path d=\"M0.75 0v8M79.25 0v8\" stroke=\"currentColor\" stroke-width=\"1.5\"/><path d=\"M1.5 4H78.5\" stroke=\"currentColor\" stroke-width=\"1.2\"/><path d=\"M1.5 4L7 1.5V6.5zM78.5 4L73 1.5V6.5z\" fill=\"currentColor\"/></svg></span><nav class=\"ds-nav-links\"><a href=\"#\" class=\"ds-nav-link is-current\" aria-current=\"page\">Open jobs</a><a href=\"#\" class=\"ds-nav-link\">Your jobs</a></nav></header>",
      "css": ".ds-nav{display:flex;align-items:center;justify-content:space-between;gap:1.5rem;height:4rem;padding:0 1.25rem;background:var(--sheet,#fbfcfe);border-bottom:1px solid var(--rule-strong,#7f93b3);font-family:Chivo,ui-sans-serif,system-ui,sans-serif}.ds-wordmark{display:inline-flex;flex-direction:column;line-height:1;color:var(--ink,#12213a);font-size:1.375rem;font-weight:800;letter-spacing:-0.03em}.ds-wordmark svg{margin-top:0.25rem;height:0.5rem;width:100%;color:var(--blue,#1a4e9e)}.ds-nav-links{display:flex;gap:1.75rem}.ds-nav-link{position:relative;display:inline-flex;align-items:center;min-height:2.75rem;font-weight:500;color:var(--ink,#12213a);text-decoration:none;transition:color 150ms cubic-bezier(0.16,1,0.3,1)}.ds-nav-link:hover{color:var(--blue,#1a4e9e)}.ds-nav-link.is-current{color:var(--blue,#1a4e9e)}.ds-nav-link.is-current::after{content:\"\";position:absolute;left:0;right:0;bottom:0;height:2px;background:var(--blue,#1a4e9e)}.ds-nav-link:focus-visible{outline:2px solid var(--blue,#1a4e9e);outline-offset:3px}"
    },
    {
      "name": "Sheet with Title Block",
      "kind": "card",
      "refersTo": "sheet",
      "description": "The document surface: double frame, one soft drop, ruled title block in the corner.",
      "html": "<article class=\"ds-sheet\"><h3 class=\"ds-sheet-title\">Move our office network onto a managed firewall</h3><p class=\"ds-sheet-body\">Replace the ISP router with a managed firewall and keep guest Wi-Fi apart.</p><dl class=\"ds-title-block\"><div><dt>Sheet</dt><dd class=\"ds-sheet-no\">No. 7C41E2</dd></div><div><dt>State</dt><dd class=\"ds-state\"><svg width=\"12\" height=\"12\" viewBox=\"0 0 12 12\" aria-hidden=\"true\"><circle cx=\"6\" cy=\"6\" r=\"4.75\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\"/></svg>Open</dd></div><div class=\"ds-wide\"><dt>Category</dt><dd>Networking</dd></div></dl></article>",
      "css": ".ds-sheet{position:relative;max-width:34rem;padding:1.75rem;background:var(--sheet,#fbfcfe);border:1px solid var(--rule-strong,#7f93b3);box-shadow:inset 0 0 0 5px var(--sheet,#fbfcfe),inset 0 0 0 6px var(--rule,#c3d2e6),0 12px 28px -22px rgb(18 33 58 / 0.55);font-family:Chivo,ui-sans-serif,system-ui,sans-serif;color:var(--ink,#12213a)}.ds-sheet-title{margin:0;font-size:1.5rem;font-weight:700;line-height:1.2;letter-spacing:-0.02em}.ds-sheet-body{margin:0.75rem 0 1.5rem;color:var(--ink-2,#475872);line-height:1.55}.ds-title-block{display:grid;grid-template-columns:1fr 1fr;gap:1px;margin:0 0 0 auto;max-width:19rem;border:1.5px solid var(--ink,#12213a);background:var(--ink,#12213a)}.ds-title-block>div{padding:0.5rem 0.75rem;background:var(--sheet,#fbfcfe)}.ds-title-block .ds-wide{grid-column:span 2}.ds-title-block dt{font-size:0.8125rem;line-height:1.3;font-weight:500;color:var(--ink-2,#475872)}.ds-title-block dd{margin:0.125rem 0 0;font-weight:600}.ds-sheet-no{font-family:\"Chivo Mono\",ui-monospace,\"SF Mono\",monospace;font-weight:400;letter-spacing:0}.ds-state{display:inline-flex;align-items:center;gap:0.375rem;font-size:0.875rem;color:var(--blue,#1a4e9e)}"
    },
    {
      "name": "State Mark",
      "kind": "chip",
      "refersTo": "state-mark",
      "description": "Drawing-legend symbol plus its word; colour only reinforces.",
      "html": "<span class=\"ds-marks\"><span class=\"ds-mark ds-open\"><svg width=\"12\" height=\"12\" viewBox=\"0 0 12 12\" aria-hidden=\"true\"><circle cx=\"6\" cy=\"6\" r=\"4.75\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\"/></svg>Open</span><span class=\"ds-mark ds-hold\"><svg width=\"12\" height=\"12\" viewBox=\"0 0 12 12\" aria-hidden=\"true\"><circle cx=\"6\" cy=\"6\" r=\"4.75\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\"/><path d=\"M6 1.25a4.75 4.75 0 0 1 0 9.5z\" fill=\"currentColor\"/></svg>In progress</span><span class=\"ds-mark ds-ok\"><svg width=\"12\" height=\"12\" viewBox=\"0 0 12 12\" aria-hidden=\"true\"><circle cx=\"6\" cy=\"6\" r=\"5.25\" fill=\"currentColor\"/></svg>Accepted</span><span class=\"ds-mark ds-red\"><svg width=\"12\" height=\"12\" viewBox=\"0 0 12 12\" aria-hidden=\"true\"><circle cx=\"6\" cy=\"6\" r=\"4.75\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\"/><path d=\"M3.4 3.4l5.2 5.2M8.6 3.4l-5.2 5.2\" stroke=\"currentColor\" stroke-width=\"1.5\"/></svg>Declined</span></span>",
      "css": ".ds-marks{display:flex;flex-wrap:wrap;gap:1.25rem;font-family:Chivo,ui-sans-serif,system-ui,sans-serif}.ds-mark{display:inline-flex;align-items:center;gap:0.375rem;font-size:0.875rem;font-weight:600;white-space:nowrap}.ds-open{color:var(--blue,#1a4e9e)}.ds-hold{color:var(--hold,#8a5500)}.ds-ok{color:var(--approved,#1e6a45)}.ds-red{color:var(--redline,#b7331c)}"
