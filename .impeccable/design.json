      "refersTo": "button-primary",
      "description": "Blueprint blue, square; the action that moves a job forward.",
      "html": "<button class=\"ds-btn-primary\">Post a job</button>",
      "css": ".ds-btn-primary{display:inline-flex;align-items:center;justify-content:center;min-height:2.75rem;padding:0.625rem 1.25rem;border-radius:0;border:1px solid var(--blue,#1a4e9e);background:var(--blue,#1a4e9e);color:#fff;font:600 1rem/1.2 Chivo,ui-sans-serif,system-ui,sans-serif;cursor:pointer;transition:background-color 150ms cubic-bezier(0.16,1,0.3,1),border-color 150ms cubic-bezier(0.16,1,0.3,1),transform 100ms cubic-bezier(0.16,1,0.3,1)}.ds-btn-primary:hover{background:var(--blue-deep,#133c7b);border-color:var(--blue-deep,#133c7b)}.ds-btn-primary:active{transform:translateY(1px)}.ds-btn-primary:focus-visible{outline:2px solid var(--blue,#1a4e9e);outline-offset:3px}"
    },
